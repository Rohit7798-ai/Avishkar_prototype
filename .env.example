# ==============================================================================
# Farmer Decision Support System - Environment Configuration Template
# NOTE: This file contains placeholders only. Never commit production secrets.
# ==============================================================================

# Application Environment (development | production | testing)
ENVIRONMENT=development

# Core Service Configuration
PROJECT_NAME="farmer-decision-system"
API_V1_STR="/api"
HOST="127.0.0.1"
PORT=8000
LOG_LEVEL="INFO"

# Database Configuration
# Default: SQLite database located in data/farmer_decision.db
DATABASE_URL="sqlite:///data/farmer_decision.db"
# Production PostgreSQL Example:
# DATABASE_URL="postgresql://username:password@localhost:5432/farmer_decision_db"

# CORS Configuration (JSON array or comma-separated origins)
# In production, specify exact allowed frontend origins (no wildcards allowed)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# External Weather Provider (Open-Meteo REST API)
# Free for non-commercial open data; no API key required
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_TIMEOUT_SECONDS=10.0

# External Market Provider (Government of India Open Government Data - data.gov.in)
OGD_MANDI_API_URL="https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070"
OGD_API_KEY=""
OGD_TIMEOUT_SECONDS=10.0

# Frontend Client Configuration
VITE_API_BASE_URL="http://127.0.0.1:8000"
